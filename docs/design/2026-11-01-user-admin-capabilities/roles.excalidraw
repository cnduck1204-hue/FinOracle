      "link": null,
      "locked": false,
      "text": "U = users.id；S = 当前会话 sid；A1/R1 与 A2/R2 是示意名称。JWT 载荷可读、由服务端密钥签名；不放密码。",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "roughness": 1,
