    {
      "id": "1ceb35abf5ae4279aa7613b07fdf42d0",
      "type": "text",
      "x": 3218,
      "y": 2818,
      "width": 516.4599999999999,
      "height": 85,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
