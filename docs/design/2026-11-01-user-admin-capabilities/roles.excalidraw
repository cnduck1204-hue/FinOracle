    {
      "id": "e73844d3803d4804879000dcd95a8440",
      "type": "text",
      "x": 2478,
      "y": 1038,
      "width": 536.5199999999999,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "groupIds": [
