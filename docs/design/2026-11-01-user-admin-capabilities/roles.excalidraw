    {
      "id": "6669312a84f547d3bb6069124e14e85b",
      "type": "text",
      "x": 2478,
      "y": 1578,
      "width": 411.05999999999995,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
