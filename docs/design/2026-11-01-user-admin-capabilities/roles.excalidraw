      ],
      "frameId": null,
      "seed": 681205835,
      "version": 1,
      "versionNonce": 965287831,
      "isDeleted": false,
      "opacity": 100,
      "link": null,
      "locked": false,
      "text": "本次登录生成 session_id=S。\nauthenticate_with_login_limit() 检查登录限制。\nget_by_identifier() 查询账号，verify_password() 验证。\n用 Argon2 校验 password 与 password_hash。\n检查用户启用状态；失败立即停止。",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "roughness": 1,
      "index": "b1z",
      "updated": 1793535491488,
      "originalText": "本次登录生成 session_id=S。\nauthenticate_with_login_limit() 检查登录限制。\nget_by_identifier() 查询账号，verify_password() 验证。\n用 Argon2 校验 password 与 password_hash。\n检查用户启用状态；失败立即停止。",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
