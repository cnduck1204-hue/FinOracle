    {
      "id": "495d45f8999646b6bff37b0146fb4b47",
      "type": "text",
      "x": 2478,
      "y": 3398,
      "width": 386.58,
      "height": 85,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
