    },
    {
      "id": "483b48f53d874a7f9b038be6708fa01d",
      "type": "text",
      "x": 3218,
      "y": 3088,
      "width": 401.87999999999994,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "groupIds": [
        "a0500f80430245d6a2fb7a3f25df5cb8"
      ],
      "frameId": null,
      "seed": 225334799,
      "version": 1,
      "versionNonce": 891994787,
      "isDeleted": false,
      "opacity": 100,
      "link": null,
      "locked": false,
      "text": "对 sid=S 比较 expected_refresh_jti=r1。\n匹配：refresh_jti 从 r1 更新为 r2。\n更新 expires_at=R2.exp，并重设 EXAT。\n不匹配：设置 revoked=true，返回 replayed。\n比较与更新在一次 Redis 原子操作中完成。",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "roughness": 1,
      "index": "b3Q",
      "updated": 1793535491489,
      "originalText": "对 sid=S 比较 expected_refresh_jti=r1。\n匹配：refresh_jti 从 r1 更新为 r2。\n更新 expires_at=R2.exp，并重设 EXAT。\n不匹配：设置 revoked=true，返回 replayed。\n比较与更新在一次 Redis 原子操作中完成。",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
