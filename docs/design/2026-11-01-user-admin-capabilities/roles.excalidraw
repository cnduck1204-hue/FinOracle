    {
      "id": "878c33c140de4407bb8e39de696282a2",
      "type": "text",
      "x": 3218,
      "y": 3398,
      "width": 435.2,
      "height": 85,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
