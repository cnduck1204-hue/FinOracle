        "a75ced8674244ac6b094130ca1b98753"
      ],
      "frameId": null,
      "seed": 523453927,
      "version": 1,
      "versionNonce": 352119214,
      "isDeleted": false,
      "opacity": 100,
      "link": null,
      "locked": false,
      "text": "内存 A1 / R1 → A2 / R2。\nsessionStorage 用 R2 覆盖 R1。\npublish 更新 user 与 Access 到期时间。\n原业务请求用 Authorization: Bearer A2 重试。",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "roughness": 1,
      "index": "b3W",
      "updated": 1793535491489,
      "originalText": "内存 A1 / R1 → A2 / R2。\nsessionStorage 用 R2 覆盖 R1。\npublish 更新 user 与 Access 到期时间。\n原业务请求用 Authorization: Bearer A2 重试。",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
