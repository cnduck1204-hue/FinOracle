    },
    {
      "id": "ed24dd395ca24b47b3706300117df963",
      "type": "text",
      "x": 3218,
      "y": 1038,
      "width": 480.41999999999996,
      "height": 85,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "groupIds": [
        "66f04dd2c4e046c994ef7d858e955971"
      ],
      "frameId": null,
      "seed": 99300345,
      "version": 1,
      "versionNonce": 622480127,
      "isDeleted": false,
      "opacity": 100,
      "link": null,
      "locked": false,
      "text": "MySQL users：按规范化用户名／邮箱精确匹配。\nRedis LoginFailureStore：读取／累计／清除失败计数。\npassword_hash 只用于服务端校验。\n密码错 401；禁用 403；登录次数受限 429。",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "roughness": 1,
      "index": "b22",
      "updated": 1793535491488,
      "originalText": "MySQL users：按规范化用户名／邮箱精确匹配。\nRedis LoginFailureStore：读取／累计／清除失败计数。\npassword_hash 只用于服务端校验。\n密码错 401；禁用 403；登录次数受限 429。",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
