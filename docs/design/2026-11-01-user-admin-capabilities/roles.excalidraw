    {
      "id": "b09a685dff4c4426ba2f577228a86b1e",
      "type": "text",
      "x": 2478,
      "y": 1288,
      "width": 512.38,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "groupIds": [
        "d72734d191504fb5adeba04e66186f1c"
      ],
      "frameId": null,
      "seed": 735995427,
      "version": 1,
      "versionNonce": 746487323,
      "isDeleted": false,
      "opacity": 100,
      "link": null,
      "locked": false,
      "text": "UserRepository.get_by_id_for_update(U) 锁行。\n事务内再次检查 status=active。\ncreate_token() → jwt.encode(..., JWT_SECRET_KEY)\n生成 A1(jti=a1)、R1(jti=r1)，二者共享 sid=S。\n密钥来自服务端配置，iat / exp 由服务端生成。",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "roughness": 1,
      "index": "b25",
      "updated": 1793535491488,
      "originalText": "UserRepository.get_by_id_for_update(U) 锁行。\n事务内再次检查 status=active。\ncreate_token() → jwt.encode(..., JWT_SECRET_KEY)\n生成 A1(jti=a1)、R1(jti=r1)，二者共享 sid=S。\n密钥来自服务端配置，iat / exp 由服务端生成。",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
