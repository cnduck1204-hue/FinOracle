      "index": "b42",
      "updated": 1793535491489,
      "originalText": "先 get_current_user(A2) 完成认证。\ndecode_token(expected_type=\"access\") 取得 sid=S。\n调用 SessionStore.revoke(S)。",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
