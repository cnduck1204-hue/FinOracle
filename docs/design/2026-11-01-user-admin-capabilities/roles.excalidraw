    {
      "id": "ee05e1f23228452f8f5d3f60bbbbd4d2",
      "type": "text",
      "x": 3218,
      "y": 1288,
      "width": 513.06,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "groupIds": [
        "cb156748647e40d6a5107e58e62e3266"
      ],
      "frameId": null,
      "seed": 475728117,
      "version": 1,
      "versionNonce": 745368327,
      "isDeleted": false,
      "opacity": 100,
      "link": null,
      "locked": false,
      "text": "更新 users.last_login_at 并 flush。\nSessionRecord: id=S, user_id=U, refresh_jti=r1\n保存 auth_version，expires_at=R1.exp。\nSessionStore.create(record)，Redis 以 EXAT 设过期。\n退出 session.begin()，MySQL 提交成功。",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "roughness": 1,
      "index": "b28",
      "updated": 1793535491488,
      "originalText": "更新 users.last_login_at 并 flush。\nSessionRecord: id=S, user_id=U, refresh_jti=r1\n保存 auth_version，expires_at=R1.exp。\nSessionStore.create(record)，Redis 以 EXAT 设过期。\n退出 session.begin()，MySQL 提交成功。",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
