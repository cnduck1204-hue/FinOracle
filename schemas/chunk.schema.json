{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG article chunk",
  "type": "object",
  "required": [
    "doc_id",
    "chunk_id",
    "chapter",
    "article",
    "content",
    "page_start",
    "page_end"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "article": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "type": "string"
    },
    "page_start": {
      "type": "integer",
      "minimum": 1
    },
    "page_end": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
