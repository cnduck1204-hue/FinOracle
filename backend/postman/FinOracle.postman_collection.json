    {
      "name": "Optional administrator checks",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get('run_admin') !== 'true') {",
              "  pm.execution.skipRequest();",
              "} else if (!pm.environment.get('admin_identifier') || !pm.environment.get('admin_password')) {",
              "  throw new Error('Provide local administrator credentials for the optional admin folder');",
              "} else if (!pm.variables.get('generated_user_id') || !/^postman_[0-9a-f]{20}$/.test(pm.variables.get('generated_username') || '')) {",
              "  throw new Error('Run registration first; administrator actions require the current generated user');",
              "}"
            ]
          }
        }
      ],
      "item": [
