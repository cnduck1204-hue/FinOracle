                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.variables.set('access_token', data.access_token);",
                  "  pm.variables.set('refresh_token', data.refresh_token);",
                  "  pm.test('Bearer token pair', () => {",
                  "    pm.expect(data.token_type).to.eql('bearer');",
                  "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(data.refresh_token).to.be.a('string').and.not.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
