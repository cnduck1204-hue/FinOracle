# Run `python3 scripts/init_env.py` to generate .env with independent random secrets.
APP_NAME=FinOracle API
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
OPENAPI_ENABLED=true
API_PORT=8001

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finoracle
MYSQL_USER=finoracle
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
