# Run `python3 scripts/init_env.py` to generate .env with independent random secrets.
APP_NAME=FinOracle API
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
OPENAPI_ENABLED=true
API_PORT=8001

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finoracle
MYSQL_USER=finoracle
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Optional: set all three values to initialize the first administrator.
# Repeated starts preserve the existing administrator and password.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Document parsing (API and scripts/parse_document.py). Parsing thresholds live in
# app/rag/parsing/options.py. .doc/.rtf/.odt are converted to PDF by Gotenberg when
# GOTENBERG_URL is set (Compose sets it for the API container; use
# http://127.0.0.1:3000 for a local uvicorn or CLI), otherwise by local LibreOffice
# (SOFFICE_PATH, empty uses PATH).
GOTENBERG_URL=
GOTENBERG_PORT=3000
SOFFICE_PATH=
CONVERSION_TIMEOUT_SECONDS=120

# Object storage for uploaded documents, accessed through the S3 API. Compose runs
# Silo (the maintained MinIO fork) and uses S3_ACCESS_KEY / S3_SECRET_KEY as its root
# credentials. The API container uses http://minio:9000; a local uvicorn or script
# uses the published port below. The bucket is created on first upload.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=finoracle
S3_SECRET_KEY=
S3_BUCKET=finoracle-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Background worker (python -m app.worker; Compose service `worker`). Poll interval
# when idle, and the job lease renewed every 5 seconds while a job runs.
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=60
# Index fully parsed versions automatically; false requires the approve endpoint.
AUTO_APPROVE_PARSED=true

# Vectorization: the worker embeds chunks, the API embeds search queries. DashScope
# OpenAI-compatible endpoint; Beijing region by
# default, https://dashscope-intl.aliyuncs.com/compatible-mode/v1 for the international
# site. Keep the key out of version control; a shell variable overrides this file
# when Compose starts. Offline indexing and online queries must use the same model and
# dimension; changing either writes to a new Milvus collection.
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# Milvus vector store. Containers use http://milvus:19530; a local uvicorn or worker
# uses the published port below.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_PORT=19530
